# Nenhum segredo real aqui. Copie para .env.local e preencha apenas em ambientes autorizados.
# Webhook (CRM/automação) que recebe solicitações. Sem ele, a API responde em MODO DEMONSTRAÇÃO e nada é enviado.
INQUIRY_WEBHOOK_URL=
# Segredo opcional enviado no header X-777-Signature para o webhook.
INQUIRY_WEBHOOK_SECRET=
# GA4 (opcional). Só carrega após consentimento explícito do visitante.
NEXT_PUBLIC_GA_ID=
# Link comercial da SET77 Labs exibido no epílogo (opcional).
NEXT_PUBLIC_SET77_URL=
